// Firestore security rules for the Practice Quiz app.
//
// This is the REAL enforcement layer for student accounts — the app's
// JavaScript only makes for a nicer experience, but these rules are what
// actually decide who can read or write what. Paste this exact text into
// the Firebase console: Build -> Firestore Database -> Rules -> Publish.
//
// What this enforces:
//   - A student can only read/write their OWN profile (users/{uid}).
//   - A student can only read their OWN attempt records, never anyone
//     else's, and can never list all attempts.
//   - A student gets at most TWO attempts per exam: the first write must
//     be attemptNumber 1 (create, only if no attempt doc exists yet), and
//     exactly one retake is allowed after that — an update that moves
//     attemptNumber from 1 to 2, for that same student and exam only.
//     A third attempt (another update once attemptNumber is already 2)
//     is rejected outright, and so is anyone trying to touch someone
//     else's attempt or switch which exam/uid a document belongs to.
//   - A submitted attempt can never be deleted by the student -- only
//     the teacher's own account can delete one, to reset a student back
//     to "no attempt yet" for that exam (e.g. a mistaken test run, or
//     clearing a used-up retake so they can try again).
//   - Only the teacher's own account (matched by email below) can list
//     every attempt across every student, which is what powers the
//     admin dashboard.
//
// To add more teacher/admin accounts later, add another
// "|| request.auth.token.email == '...'" clause inside isAdmin().
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ashraf2k@gmail.com';
    }

    match /users/{uid} {
      allow get, write: if request.auth != null && request.auth.uid == uid;
      allow get: if isAdmin();
    }

    match /attempts/{attemptId} {
      // Ownership is checked from the DOCUMENT ID's own uid_examKey shape,
      // not from resource.data -- a student's very first attempt at an
      // exam doesn't exist as a document yet, so `resource` is null and
      // `resource.data.uid` would fail to evaluate, which Firestore
      // treats as a denial even for the rightful owner. The ID shape is
      // always available, existing document or not, so checking that
      // instead means a student can find out "no attempt yet" instead of
      // getting a permission error.
      allow get: if request.auth != null
                  && (attemptId.split('_')[0] == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      // First attempt: the document must not already exist, and it must
      // be written as attemptNumber 1.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && attemptId == request.resource.data.uid + '_' + request.resource.data.examKey
                    && request.resource.data.attemptNumber == 1
                    && !exists(/databases/$(database)/documents/attempts/$(attemptId));

      // The one allowed retake: resource (the EXISTING doc) is guaranteed
      // non-null here -- Firestore only classifies a write as "update"
      // when a document is already there -- so reading resource.data is
      // always safe in this branch, unlike in the get rule above. Treat a
      // pre-retake-feature attempt (no attemptNumber field at all) the
      // same as attemptNumber 1, so older records already in the
      // database are still eligible for one retake.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && resource.data.examKey == request.resource.data.examKey
                    && attemptId == request.resource.data.uid + '_' + request.resource.data.examKey
                    && (resource.data.attemptNumber == 1 || !('attemptNumber' in resource.data))
                    && request.resource.data.attemptNumber == 2;

      // Only the teacher/admin account can delete an attempt (a student
      // never can) -- this is the "reset" action in the admin dashboard,
      // letting that student take the exam fresh again.
      allow delete: if isAdmin();
    }

    // Topical exam-question practice (exam-practice.html): free-response
    // questions self-checked against a keyword-assisted grader, with
    // UNLIMITED retakes -- so unlike /attempts there's no attemptNumber
    // dance. Each document always holds just that student's most recent
    // completed run for that paper; writing it again simply overwrites it.
    match /examAttempts/{attemptId} {
      allow get: if request.auth != null
                  && (attemptId.split('_')[0] == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      allow create, update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && attemptId == request.resource.data.uid + '_' + request.resource.data.paperKey;

      allow delete: if isAdmin();
    }

    // Scratch "resume" checkpoints for an IN-PROGRESS MCQ attempt
    // (quiz.html) -- NOT a graded record (that's /attempts above). Freely
    // overwritable/deletable by its owner: whether an unfinished attempt
    // still "counts" toward the 2-attempt cap is decided entirely by
    // /attempts' own rules, same as always -- this collection never gates
    // anything by itself, it just lets a student close the tab and pick
    // up later from the same checkpoint (same device or a different one).
    match /practiceProgress/{progressId} {
      allow get: if request.auth != null
                  && (progressId.split('_')[0] == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      allow create, update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && progressId == request.resource.data.uid + '_' + request.resource.data.examKey;

      // No request.resource on a delete -- check the EXISTING document's
      // owner instead (resource, not request.resource), the same pattern
      // the get rule above uses for the same reason.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Same idea for an in-progress topical exam-question attempt
    // (exam-practice.html). Unlike practiceProgress above there's no
    // attempt cap downstream to interact with -- examAttempts already
    // allows unlimited retakes -- so this is purely a convenience
    // checkpoint.
    match /examProgress/{progressId} {
      allow get: if request.auth != null
                  && (progressId.split('_')[0] == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      allow create, update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && progressId == request.resource.data.uid + '_' + request.resource.data.paperKey;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
