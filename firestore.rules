// Firestore security rules for the Practice Quiz app (HARDENED).
//
// These rules are the REAL enforcement layer -- the app's JavaScript is only
// a convenience. Publish: Firebase console -> Firestore -> Rules -> Publish.
// READ SECURITY.md FIRST: create the admins/{your-uid} document BEFORE
// publishing, or the teacher dashboard will lock you out.
//
// Threat -> defence
//   * Admin identity is no longer an e-mail address written in this file or
//     in any HTML. An admin is whoever has a document at admins/{uid}; that
//     collection can be written only from the Firebase console / Admin SDK
//     (clients are denied), so nobody can promote themselves.
//   * Users can only create their OWN profile once (no later edits, no
//     delete), with a whitelisted, length/format-checked set of fields, and
//     the stored e-mail must equal the account's verified token e-mail
//     (no impersonation, no identity spoofing).
//   * Every student write is type-, range- and size-checked: unknown fields
//     are rejected, scores are integers with score <= total, lists are
//     capped, strings are length-capped and may not contain < > & (blocks
//     stored-XSS payloads reaching the teacher dashboard), and timestamps
//     are server-set (recordedAt == request.time) so they cannot be forged.
//   * Ownership is taken from request.auth.uid, never from user-supplied
//     data; document ids must equal uid_key, so one student can never write
//     into another student's document or enumerate other students.
//   * The attempt caps (2 attempts; comm9618 and comm9618_exam only one)
//     are unchanged and still enforced here, not in the browser.
//   * Students cannot list any collection, delete graded records, or read
//     other users. Only admins can list/regrade/reset/archive.
//   * Everything not listed below is denied (default deny + explicit
//     catch-all).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }

    // New accounts (users/{uid}.createdAt on/after 18 Oct 2026 00:00 Riyadh time = 17 Oct 21:00 UTC) must have
    // clicked the e-mail verification link before they can save anything.
    // Older accounts are grandfathered. Keep in step with firebase-init.src.js.
    // A teacher can block a student (users/{uid}.blocked = true): all of
    // that student's writes are refused until unblocked.
    function isBlocked() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true;
    }

    function verifiedOrLegacy() {
      return !isBlocked() && (request.auth.token.email_verified == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             .get('createdAt', timestamp.date(2000, 1, 1)) < timestamp.value(1792270800000));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- subscriptions (users/{uid}.sub, written ONLY by an admin) ----------
    // sub = { plan, start, expiry, isTrial, suspended, grace, by, byUid, modified }.
    // A brand-new account must carry exactly { plan: 'trial', start: request.time } (server time), and its
    // expiry is start + 24 hours, worked out here so the student's device clock and browser storage cannot move it.
    // An account WITHOUT a sub field is an existing (legacy) student: full access, nothing changes for them.
    // An admin-set sub carries an explicit expiry. suspended == true blocks access whatever the dates say.
    // grace (optional timestamp) gives temporary access past the expiry without changing the expiry.
    function trialShape(s) {
      return s is map && s.keys().hasOnly(['plan', 'start']) && s.keys().hasAll(['plan', 'start'])
        && s.plan == 'trial' && s.start == request.time;
    }
    function subExpiry(s) {
      return (s.plan == 'trial' && !('expiry' in s)) ? s.start + duration.value(24, 'h') : s.expiry;
    }
    function subValid(s) {
      return s.get('suspended', false) != true
        && (subExpiry(s) > request.time
            || (s.get('grace', null) != null && s.grace > request.time));
    }
    function hasAccess() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('sub', null) == null
            || subValid(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sub));
    }
    // Verified e-mail (or legacy) AND a valid subscription: used for the learning data that is subscription-protected.
    function entitled() { return verifiedOrLegacy() && hasAccess(); }

    // Staff roles (users/{uid}.role, set only by an admin):
    //   teacher      = reads and writes everything the dashboard needs (not roles / admins),
    //   collaborator = read-only view of the dashboard data.
    function staffRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') : 'student';
    }
    function canRead() { return isAdmin() || staffRole() in ['teacher', 'collaborator']; }
    function canWrite() { return isAdmin() || staffRole() == 'teacher'; }
    // Teachers may edit student profiles but never change anyone's role or subscription (admins only).
    function canWriteUser() {
      return isAdmin() || (staffRole() == 'teacher'
        && (request.method == 'delete'
            || (request.method == 'create' && !('role' in request.resource.data)
                && (!('sub' in request.resource.data) || trialShape(request.resource.data.sub)))
            || (request.method == 'update' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'sub']))));
    }
    // A parent linked (by a teacher) to this student: parentLinks/{parentUid}_{childUid}.
    function parentOf(childUid) {
      return signedIn() && childUid is string && exists(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + childUid));
    }

    // Plain text: bounded length, and none of < > & (HTML metacharacters).
    function safeText(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen
        && v.matches('[^<>&]*');
    }
    function isNum(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }
    function isCount(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function validKey(k) { return k is string && k.matches('[A-Za-z0-9_-]{1,60}'); }
    function validClass(c) { return c is string && c.matches('[A-Za-z0-9 ._-]{1,20}'); }
    function validWhen(v) { return v is string && v.size() >= 8 && v.size() <= 40 && v.matches('[0-9TZ:.+ -]*'); }
    function validMinutes(v) { return v == null || isNum(v, 0, 1440); }

    function validFirstAttempt(f) {
      return f == null || (f is map
        && f.keys().hasOnly(['score', 'total', 'completedAt', 'minutesTaken'])
        && isNum(f.get('score', 0), 0, 500)
        && isNum(f.get('total', 0), 0, 500)
        && (f.get('completedAt', null) == null || validWhen(f.get('completedAt', null)))
        && validMinutes(f.get('minutesTaken', null)));
    }

    function validAttempt(uid, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'examKey', 'name', 'class', 'attemptNumber', 'score',
                               'total', 'answers', 'hints', 'completedAt', 'minutesTaken',
                               'recordedAt', 'firstAttempt', 'abandoned'])
        && d.keys().hasAll(['uid', 'examKey', 'name', 'class', 'attemptNumber', 'score',
                            'total', 'answers', 'completedAt', 'recordedAt'])
        && d.uid == uid
        && validKey(d.examKey)
        && id == uid + '_' + d.examKey
        && safeText(d.name, 1, 80)
        && validClass(d['class'])
        && isCount(d.attemptNumber, 1, 2)
        && isNum(d.total, 0, 500)
        && isNum(d.score, 0, 500) && d.score <= d.total
        && d.answers is list && d.answers.size() <= 500
        && (!('hints' in d) || (d.hints is list && d.hints.size() <= 500))
        && validWhen(d.completedAt)
        && validMinutes(d.get('minutesTaken', null))
        && d.recordedAt == request.time
        && validFirstAttempt(d.get('firstAttempt', null))
        && (!('abandoned' in d) || d.abandoned is bool);
    }

    function validExamAttempt(uid, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'paperKey', 'name', 'class', 'perQuestion', 'totalEarned',
                               'totalMarks', 'pct', 'topicStats', 'completedAt', 'minutesTaken',
                               'recordedAt'])
        && d.keys().hasAll(['uid', 'paperKey', 'name', 'class', 'perQuestion', 'totalEarned',
                            'totalMarks', 'pct', 'completedAt', 'recordedAt'])
        && d.uid == uid
        && validKey(d.paperKey)
        && id == uid + '_' + d.paperKey
        && safeText(d.name, 1, 80)
        && validClass(d['class'])
        && isNum(d.totalMarks, 0, 2000)
        && isNum(d.totalEarned, 0, 2000) && d.totalEarned <= d.totalMarks
        && isNum(d.pct, 0, 100)
        && d.perQuestion is list && d.perQuestion.size() <= 400
        && (!('topicStats' in d) || (d.topicStats is list && d.topicStats.size() <= 400))
        && validWhen(d.completedAt)
        && validMinutes(d.get('minutesTaken', null))
        && d.recordedAt == request.time;
    }

    // Student feedback on the iLearn journey (one doc per student: <uid>_<journey>).
    function validFeedback(uid, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid','journey','cls','progress','name','email','level','levelOther','device','freq',
                               'overall','ease','design','materials','practice','exam',
                               'useful','usefulOther','problems','findEase','mobile',
                               'best','weakness','feature','other','recommend','createdAt','updatedAt'])
        && d.keys().hasAll(['uid','journey','cls','progress','name','email','level','levelOther','device','freq',
                            'overall','ease','design','materials','practice','exam',
                            'useful','usefulOther','problems','findEase','mobile',
                            'best','weakness','feature','other','recommend','createdAt','updatedAt'])
        && d.uid == uid && d.journey in ['ilearn10br']
        && id == uid + '_' + d.journey
        && validClass(d.cls)
        && isCount(d.progress, 0, 100)
        // Identity comes from the account, never from the form.
        && safeText(d.name, 1, 80)
        && d.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && d.email is string && request.auth.token.email != null
        && d.email.lower() == request.auth.token.email.lower()
        && d.level in ['igcse','as','a','other'] && safeText(d.levelOther, 0, 40)
        && d.device in ['mobile','tablet','laptop','desktop']
        && d.freq in ['daily','few','weekly','less']
        && isCount(d.overall, 1, 5) && isCount(d.ease, 1, 5) && isCount(d.design, 1, 5)
        && isCount(d.materials, 1, 5) && isCount(d.practice, 1, 5) && isCount(d.exam, 1, 5)
        && d.useful is list && d.useful.size() <= 7
        && d.useful.hasOnly(['explain','quiz','instant','organised','nav','progress','interactive'])
        && safeText(d.usefulOther, 0, 100)
        && d.problems is list && d.problems.size() <= 8
        && d.problems.hasOnly(['find','tech','unclear','fewq','layout','mobile','missing','none'])
        && d.findEase in ['veasy','easy','neutral','hard','vhard']
        && d.mobile in ['excellent','good','ok','poor','none']
        && safeText(d.best, 0, 600) && safeText(d.weakness, 0, 600)
        && safeText(d.feature, 0, 600) && safeText(d.other, 0, 600)
        && d.recommend in ['definitely','probably','unsure','probnot','defnot']
        && d.updatedAt == request.time;
    }

    // ---------- tuition booking helpers ----------
    // A student has two "seats" (<uid>_1, <uid>_2) = at most two slots. Slot exclusivity comes from
    // tuitionTaken/<slotKey>: a student can only CREATE it (never update), so it can be created once.
    function tuSeat(uid, bid) { return bid == uid + '_1' || bid == uid + '_2'; }
    function tuBooking(bid) { return /databases/$(database)/documents/tuitionBookings/$(bid); }
    function tuOwnsAfter(slotKey) {
      return (existsAfter(tuBooking(request.auth.uid + '_1')) && getAfter(tuBooking(request.auth.uid + '_1')).data.slotKey == slotKey)
          || (existsAfter(tuBooking(request.auth.uid + '_2')) && getAfter(tuBooking(request.auth.uid + '_2')).data.slotKey == slotKey);
    }
    function tuOwnsBefore(slotKey) {
      return (exists(tuBooking(request.auth.uid + '_1')) && get(tuBooking(request.auth.uid + '_1')).data.slotKey == slotKey)
          || (exists(tuBooking(request.auth.uid + '_2')) && get(tuBooking(request.auth.uid + '_2')).data.slotKey == slotKey);
    }
    function validTuitionBooking(uid, bid) {
      let d = request.resource.data;
      let cfg = get(/databases/$(database)/documents/tuitionConfig/main).data;
      let me = get(/databases/$(database)/documents/users/$(uid)).data;
      return d.keys().hasOnly(['uid','slotKey','name','grade','status','createdAt'])
        && d.keys().hasAll(['uid','slotKey','name','grade','status','createdAt'])
        && d.uid == uid && tuSeat(uid, bid)
        && d.status == 'pending'
        && cfg.get('open', false) == true
        && d.slotKey is string && d.slotKey in cfg.get('slots', [])
        && safeText(d.name, 1, 80) && d.name == me.name
        && validClass(d.grade) && d.grade == me['class']
        && d.createdAt == request.time;
    }

    // A student may ask to move an APPROVED booking to another free slot: only changeTo/changeAt can be set,
    // the target must be a listed slot that is not taken. The teacher moves the booking (or declines).
    function validTuitionChange(k) {
      let cfg = get(/databases/$(database)/documents/tuitionConfig/main).data;
      return cfg.get('open', false) == true
        && k is string && k in cfg.get('slots', [])
        && !exists(/databases/$(database)/documents/tuitionTaken/$(k))
        && request.resource.data.get('changeAt', null) == request.time;
    }

    // Resume checkpoints / iLearn state: owner-only, free-shaped but bounded.
    function validProgress(uid, id, keyField) {
      let d = request.resource.data;
      return d.uid == uid
        && d[keyField] is string
        && validKey(d[keyField])
        && id == uid + '_' + d[keyField]
        && d.keys().size() <= 60
        && d.updatedAt == request.time;
    }

    // ---------- live sessions (small online groups, max 5 students per slot) ----------
    // The bookable slot keys (day_HHMM, Saudi time). Keep in step with live-slots.js.
    function liveSlotKeys() { return ['sat_1300', 'sat_1700', 'mon_1800', 'tue_1730', 'wed_1730', 'thu_1630', 'thu_1830']; }
    function examSessions() { return ['Feb/March 2027', 'May/June 2027', 'Oct/Nov 2027', 'May/June 2028 or later']; }
    function liveSlotPath(k) { return /databases/$(database)/documents/liveSlots/$(k); }
    function liveCount(k) { return exists(liveSlotPath(k)) ? get(liveSlotPath(k)).data.count : 0; }
    function liveCountAfter(k) { return existsAfter(liveSlotPath(k)) ? getAfter(liveSlotPath(k)).data.count : 0; }
    function liveBookingPath(uid) { return /databases/$(database)/documents/liveBookings/$(uid); }
    function validLiveEntry(uid, st) {
      let d = request.resource.data;
      let me = get(/databases/$(database)/documents/users/$(uid)).data;
      return d.keys().hasOnly(['uid', 'slotKey', 'name', 'email', 'whatsapp', 'iso', 'class', 'examSession', 'status', 'createdAt'])
        && d.keys().hasAll(['uid', 'slotKey', 'name', 'email', 'whatsapp', 'class', 'status', 'createdAt'])
        && d.uid == uid
        && d.slotKey in liveSlotKeys()
        && safeText(d.name, 1, 80) && d.name == me.name
        && d.email is string && request.auth.token.email != null && d.email.lower() == request.auth.token.email.lower()
        && d.whatsapp is string && d.whatsapp.matches('^[+][0-9]{8,15}$')
        && (!('iso' in d) || (d.iso is string && d.iso.size() == 2))
        && validClass(d['class']) && d['class'] == me['class']
        && (!('examSession' in d) || (d.examSession is string && d.examSession.size() <= 30 && d.examSession.matches('[A-Za-z0-9/ ]*')))
        && me.get('role', 'student') == 'student'
        && d.status == st
        && d.createdAt == request.time;
    }

    // ---------- admins (read-only marker docs; written from console only) ----------
    match /admins/{uid} {
      // A signed-in user may check ONLY whether they themselves are an admin.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      // An admin can promote another person to admin or remove another admin (never themselves).
      allow create: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
      allow list, update: if false;
    }

    // ---------- groups (classes with a code) ----------
    match /groups/{code} {
      // Any signed-in user can look up ONE group by its code (to join); only admins can list.
      allow get: if signedIn();
      // Anyone (also before sign-up) may list the classes, so the sign-up form can offer the open ones.
      // A class document holds only its code, level, name, teacher name and open flag: nothing private.
      allow list: if true;
      allow create, update, delete: if canWrite();
    }

    // ---------- join requests (student -> teacher approves) ----------
    function validJoin(uid, rid) {
      let d = request.resource.data;
      let g = get(/databases/$(database)/documents/groups/$(d.code)).data;
      return d.keys().hasOnly(['uid','code','name','status','createdAt'])
        && d.keys().hasAll(['uid','code','name','status','createdAt'])
        && d.uid == uid && d.code is string && d.code.matches('[A-Z0-9]{5,20}')
        && rid == uid + '_' + d.code
        && exists(/databases/$(database)/documents/groups/$(d.code))
        && g.get('open', true) == true
        && d.status == 'pending'
        && d.name == get(/databases/$(database)/documents/users/$(uid)).data.name
        && d.createdAt == request.time;
    }
    match /joinRequests/{rid} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || canRead());
      allow list: if signedIn() && (canRead() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && verifiedOrLegacy() && validJoin(request.auth.uid, rid);
      allow update: if signedIn() && verifiedOrLegacy() && resource.data.uid == request.auth.uid
        && resource.data.status == 'declined' && validJoin(request.auth.uid, rid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid && resource.data.status in ['pending','declined'];
      allow create, update, delete: if canWrite();
    }

    // ---------- parent <-> student links (admin writes; a parent reads their own) ----------
    match /parentLinks/{id} {
      allow get: if signedIn() && (id.split('_')[0] == request.auth.uid || canRead());
      allow list: if signedIn() && (canRead() || resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if canWrite();
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || canRead());
      // Teacher roster: lets the dashboard list every registered student
      // (including those who have not submitted a quiz yet).
      allow list: if canRead();
      // One-time profile creation by the owner. No later self-edit (so the
      // class / name / e-mail cannot be tampered with), no self-delete.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'email', 'class', 'createdAt', 'examSession', 'certificate', 'sub'])
                    && request.resource.data.keys().hasAll(['name', 'email', 'class', 'createdAt', 'sub'])
                    && trialShape(request.resource.data.sub)
                    && (!('examSession' in request.resource.data) || request.resource.data.examSession in examSessions())
                    && (!('certificate' in request.resource.data) || request.resource.data.certificate in ['IGCSE', 'AS', 'A2'])
                    && safeText(request.resource.data.name, 1, 80)
                    && validClass(request.resource.data['class'])
                    && request.resource.data.email is string
                    && request.auth.token.email != null
                    && request.resource.data.email.lower() == request.auth.token.email.lower()
                    && request.resource.data.createdAt == request.time;
      // A student may set the planned exam session and the certificate ONCE (when they are missing). Nothing else.
      allow update: if signedIn() && request.auth.uid == uid && verifiedOrLegacy()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['examSession', 'certificate'])
                    && !('examSession' in resource.data)
                    && request.resource.data.examSession in examSessions()
                    && request.resource.data.certificate in ['IGCSE', 'AS', 'A2'];
      // Archive / restore / change class (teacher).
      allow create, update, delete: if canWriteUser();
    }

    // ---------- subscription audit log (append-only) ----------
    match /users/{uid}/subHistory/{hid} {
      allow get, list: if canRead() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['action', 'plan', 'prevPlan', 'prevExpiry', 'newExpiry', 'startDate', 'at', 'by', 'byUid', 'reason'])
                    && request.resource.data.keys().hasAll(['action', 'plan', 'at', 'by', 'byUid'])
                    && request.resource.data.at == request.time
                    && request.resource.data.action in ['assign', 'renew', 'extend', 'change', 'suspend', 'reactivate', 'grace', 'expiry-date', 'trial'];
      allow update, delete: if false;
    }

    // ---------- archive (teacher) ----------
    match /archive/{uid} {
      // A student may read ONLY their own summary doc (login uses it to
      // turn archived accounts away).
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list: if canRead();
      allow create, update, delete: if canWrite();

      match /items/{itemId} {
        allow get, list: if canRead();
        allow create, update, delete: if canWrite();
      }
    }

    // ---------- MCQ attempts (max 2; comm9618 max 1) ----------
    match /attempts/{attemptId} {
      allow get: if signedIn() && (attemptId.split('_')[0] == request.auth.uid && hasAccess() || canRead() || parentOf(attemptId.split('_')[0]));
      allow list: if canRead() || (signedIn() && parentOf(resource.data.uid));

      allow create: if signedIn() && entitled()
                    && validAttempt(request.auth.uid, attemptId)
                    && request.resource.data.attemptNumber == 1
                    && !exists(/databases/$(database)/documents/attempts/$(attemptId));

      allow update: if signedIn() && entitled()
                    && validAttempt(request.auth.uid, attemptId)
                    && resource.data.uid == request.auth.uid
                    && resource.data.examKey == request.resource.data.examKey
                    && (resource.data.attemptNumber == 1 || !('attemptNumber' in resource.data))
                    && request.resource.data.attemptNumber == 2
                    && resource.data.examKey != 'comm9618';

      allow create, update, delete: if canWrite();
    }

    // ---------- topical exam papers (unlimited retakes; comm9618_exam once) ----------
    match /examAttempts/{attemptId} {
      allow get: if signedIn() && (attemptId.split('_')[0] == request.auth.uid && hasAccess() || canRead() || parentOf(attemptId.split('_')[0]));
      allow list: if canRead() || (signedIn() && parentOf(resource.data.uid));

      allow create: if signedIn() && entitled() && validExamAttempt(request.auth.uid, attemptId);

      allow update: if signedIn() && entitled()
                    && validExamAttempt(request.auth.uid, attemptId)
                    && resource.data.uid == request.auth.uid
                    && resource.data.paperKey == request.resource.data.paperKey
                    && resource.data.paperKey != 'comm9618_exam';

      // Teacher regrade / restore / reset (no paperKey exception).
      allow create, update, delete: if canWrite();
    }

    // ---------- resume checkpoints + iLearn state ----------
    match /practiceProgress/{progressId} {
      allow get: if signedIn() && (progressId.split('_')[0] == request.auth.uid && hasAccess() || canRead() || parentOf(progressId.split('_')[0]));
      allow list: if canRead() || (signedIn() && parentOf(resource.data.uid));
      allow create, update: if signedIn() && validProgress(request.auth.uid, progressId, 'examKey') && entitled();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if canWrite();
    }

    match /examProgress/{progressId} {
      allow get: if signedIn() && (progressId.split('_')[0] == request.auth.uid && hasAccess() || canRead() || parentOf(progressId.split('_')[0]));
      allow list: if canRead() || (signedIn() && parentOf(resource.data.uid));
      allow create, update: if signedIn() && validProgress(request.auth.uid, progressId, 'paperKey') && entitled();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if canWrite();
    }

    // ---------- course enquiries from the chat assistant ----------
    // Anyone (even not signed in) may create ONE record with exactly these fields; nobody but staff can read or change it.
    function validEnquiry(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['ref','name','email','phone','iso','course','session','lessonType','schedule','level','comments','consent','lang','page','senderType','status','isRead','createdAt','uid'])
        && d.keys().hasAll(['ref','email','phone','course','consent','lang','senderType','status','isRead','createdAt'])
        && id.matches('^ENQ-[0-9]{8}-[A-Z0-9]{5}$') && d.ref == id
        && d.email is string && d.email.size() <= 120 && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.phone is string && d.phone.matches('^[+][0-9]{6,15}$')
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('iso' in d) || (d.iso is string && d.iso.size() == 2))
        && d.course in ['igcse','as','a2','other']
        && (!('session' in d) || d.session in ['mayjune','octnov','undecided'])
        && (!('lessonType' in d) || d.lessonType in ['individual','group','advice'])
        && (!('schedule' in d) || d.schedule in ['weekdays','weekends','flexible'])
        && (!('level' in d) || d.level in ['beginner','intermediate','advanced','studying'])
        && (!('comments' in d) || (d.comments is string && d.comments.size() <= 1000))
        && (!('page' in d) || (d.page is string && d.page.size() <= 200))
        && d.consent == true && d.lang in ['en','ar'] && d.senderType in ['visitor','student']
        && d.status == 'new' && d.isRead == false && d.createdAt == request.time
        && (!('uid' in d) || (signedIn() && d.uid == request.auth.uid));
    }
    match /courseEnquiries/{enquiryId} {
      allow create: if validEnquiry(enquiryId);
      allow get, list: if canRead();
      allow update: if canWrite() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','notes','isRead','updatedAt'])
        && request.resource.data.status in ['new','contacted','interested','registered','closed']
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000));
      allow delete: if canWrite();
    }

    // ---------- messages / support requests from the chat assistant ----------
    // Anyone may CREATE one (strict fields, server time, unread); only staff read them; only teachers/admins manage them.
    function validChatMessage(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['ref','kind','reason','recipient','name','email','phone','iso','message','course','page','senderType','lang','consent','transcript','status','isRead','createdAt','uid'])
        && d.keys().hasAll(['ref','kind','recipient','email','phone','message','senderType','lang','consent','status','isRead','createdAt'])
        && id.matches('^(MSG|SUP)-[0-9]{8}-[A-Z0-9]{5}$') && d.ref == id
        && d.kind in ['message','support'] && d.recipient in ['teacher','administrator']
        && (!('reason' in d) || d.reason in ['technical','payment','registration','complaint','general','human','unanswered','renewal'])
        && d.email is string && d.email.size() <= 120 && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.phone is string && d.phone.matches('^[+][0-9]{6,15}$')
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('iso' in d) || (d.iso is string && d.iso.size() == 2))
        && d.message is string && d.message.size() >= 3 && d.message.size() <= 2000
        && (!('course' in d) || d.course in ['igcse','as','a2','other'])
        && (!('page' in d) || (d.page is string && d.page.size() <= 200))
        && (!('transcript' in d) || (d.transcript is list && d.transcript.size() <= 30))
        && d.consent == true && d.lang in ['en','ar'] && d.senderType in ['visitor','student']
        && d.status == 'unread' && d.isRead == false && d.createdAt == request.time
        && (!('uid' in d) || (signedIn() && d.uid == request.auth.uid));
    }
    match /chatMessages/{messageId} {
      allow create: if validChatMessage(messageId);
      allow get, list: if canRead();
      allow update: if canWrite() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','notes','isRead','readAt','replies','updatedAt'])
        && request.resource.data.status in ['unread','read','replied','resolved','archived']
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
        && (!('replies' in request.resource.data) || (request.resource.data.replies is list && request.resource.data.replies.size() <= 30));
      allow delete: if canWrite();
    }

    // ---------- student feedback (admins read everything; a student can read/edit only their own) ----------
    match /feedback/{feedbackId} {
      allow get: if signedIn() && (feedbackId.split('_')[0] == request.auth.uid || canRead());
      allow list: if canRead();
      allow create: if signedIn() && verifiedOrLegacy()
        && validFeedback(request.auth.uid, feedbackId)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && verifiedOrLegacy()
        && resource.data.uid == request.auth.uid
        && validFeedback(request.auth.uid, feedbackId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canWrite();
    }

    // ---------- tuition booking (hidden page) ----------
    match /tuitionConfig/{id} {
      allow get: if signedIn();
      allow create, update, delete: if canWrite();
    }

    // Public "slot is taken" markers: no names, so students cannot see each other.
    match /tuitionTaken/{slotKey} {
      allow get, list: if signedIn();
      allow create: if signedIn() && verifiedOrLegacy()
        && request.resource.data.keys().hasOnly(['taken','at'])
        && request.resource.data.keys().hasAll(['taken','at'])
        && request.resource.data.taken == true
        && request.resource.data.at == request.time
        && tuOwnsAfter(slotKey);
      // A student frees a slot only by withdrawing their own pending booking in the same batch.
      allow delete: if signedIn() && tuOwnsBefore(slotKey)
        && !(existsAfter(tuBooking(request.auth.uid + '_1')) && getAfter(tuBooking(request.auth.uid + '_1')).data.slotKey == slotKey)
        && !(existsAfter(tuBooking(request.auth.uid + '_2')) && getAfter(tuBooking(request.auth.uid + '_2')).data.slotKey == slotKey);
      allow create, update, delete: if canWrite();
    }

    match /tuitionBookings/{bid} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || canRead());
      allow list: if signedIn() && (canRead() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && verifiedOrLegacy() && validTuitionBooking(request.auth.uid, bid);
      // Re-book on a seat whose previous request was declined.
      allow update: if signedIn() && verifiedOrLegacy() && resource.data.uid == request.auth.uid
        && resource.data.status == 'declined' && validTuitionBooking(request.auth.uid, bid);
      // Request / withdraw a change to an approved booking.
      allow update: if signedIn() && verifiedOrLegacy() && resource.data.uid == request.auth.uid
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['changeTo','changeAt','changeResult'])
        && !('changeResult' in request.resource.data)
        && (!('changeTo' in request.resource.data) || validTuitionChange(request.resource.data.changeTo));
      // Withdraw a pending request or dismiss a declined one (approved ones: ask the teacher).
      allow delete: if signedIn() && resource.data.uid == request.auth.uid && resource.data.status in ['pending','declined'];
      allow create, update, delete: if canWrite();
    }

    // Paid / sessions completed / notes: teacher only, students can never read it.
    match /tuitionLedger/{owner} {
      allow read: if canRead();
      allow write: if canWrite();
    }

    // My exam timetable: one private plan per student (subject picks and centre key times). Staff can read it.
    match /examPlans/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || canRead());
      allow list: if canRead();
      allow create, update: if signedIn() && request.auth.uid == uid && verifiedOrLegacy()
        && request.resource.data.keys().hasOnly(['items', 'keyAM', 'keyPM', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 14
        && request.resource.data.keyAM is string && request.resource.data.keyAM.size() <= 5
        && request.resource.data.keyPM is string && request.resource.data.keyPM.size() <= 5
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if canWrite();
    }

    // One booking document per student (id = uid), so nobody can hold two places. The slot counter lives in
    // liveSlots/{key} and may only change by exactly 1 in the same batch as the booking is created / removed,
    // never above 5.
    match /liveBookings/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || canRead());
      allow list: if canRead();
      allow create: if signedIn() && request.auth.uid == uid && entitled() && validLiveEntry(uid, 'booked')
        && liveCountAfter(request.resource.data.slotKey) == liveCount(request.resource.data.slotKey) + 1
        && liveCountAfter(request.resource.data.slotKey) <= 5;
      // A student may cancel their own booking (the counter must go down by 1 in the same batch).
      allow delete: if signedIn() && request.auth.uid == uid
        && liveCountAfter(resource.data.slotKey) == liveCount(resource.data.slotKey) - 1;
      allow create, update, delete: if canWrite();
    }
    // Waiting list for FULL slots: one entry per student (id = uid). The teacher moves a student into the slot
    // from the dashboard when a place opens.
    match /liveWaitlist/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || canRead());
      allow list: if canRead();
      allow create: if signedIn() && request.auth.uid == uid && entitled() && validLiveEntry(uid, 'waiting')
        && !exists(liveBookingPath(uid))
        && liveCount(request.resource.data.slotKey) >= 5;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if canWrite();
    }
    match /liveSlots/{k} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() && entitled() && k in liveSlotKeys()
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count is int && request.resource.data.count >= 0 && request.resource.data.count <= 5
        && request.resource.data.updatedAt == request.time
        && (
          (!exists(liveBookingPath(request.auth.uid)) && existsAfter(liveBookingPath(request.auth.uid))
            && getAfter(liveBookingPath(request.auth.uid)).data.slotKey == k
            && request.resource.data.count == liveCount(k) + 1)
          ||
          (exists(liveBookingPath(request.auth.uid)) && get(liveBookingPath(request.auth.uid)).data.slotKey == k
            && !existsAfter(liveBookingPath(request.auth.uid))
            && request.resource.data.count == liveCount(k) - 1)
        );
      allow create, update, delete: if canWrite();
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
